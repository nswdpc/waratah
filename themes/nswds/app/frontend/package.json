{
  "name": "@nswdpc/waratah",
  "license": "BSD-3-Clause",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nswdpc/waratah.git"
  },
  "description": "Frontend integration of the NSW Design System for Silverstripe websites. This package.json adds extra libraries beyond those provided by nsw-design-system",
  "main": "index.js",
  "scripts": {
    "setup": "bun install",
    "prestart": "bun run project-defaults",
    "prebuild": "bun run project-defaults",
    "prebuildall": "bun run project-defaults",
    "project-defaults": "./defaults.sh",
    "start": "bun run --watch build.ts",
    "build": "npm run build.ts",
    "buildall": "bun install --no-fund --prefer-offline --silent --no-audit && bun run build && bun run version",
    "audit": "bun audit",
    "version": "bun pm ls | grep nsw-design-system"
  },
  "author": "NSWDPC Digital",
  "contributors": [
    {
      "name": "Symbiote"
    }
  ],
  "dependencies": {
    "micromodal": "^0.4.10",
    "nsw-design-system": "3.22.11",
    "slim-select": "^2.10.0"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "sass-embedded": "^1.98.0"
  }
}
